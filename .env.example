# Copy to .env.local for local work. Only publishable values may use the VITE_ prefix.

# Signup switches. On only for the exact string "true". Leave off in production
# until approved. NAV controls the header links; signup controls the pages.
VITE_SIGNUP_ENABLED=
VITE_SIGNUP_NAV_ENABLED=

# ERP sign-in page (target of the "Sign in" link).
VITE_ERP_URL=
# API the signup flow calls. May differ from VITE_ERP_URL (staging's API is the
# public portal service).
VITE_ERP_API_URL=

# Firebase web app config (public client values).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
